      },
      "name": "Query 7 Days Overdue",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [400, 150]
    },
    {
      "parameters": {
        "operation": "select",
        "table": {
          "value": "tenants",
          "mode": "list"
        },
        "where": {
          "conditions": [
            {
              "column": "payment_status",
              "value": "overdue",
              "condition": "eq"
            },
            {
              "column": "days_overdue",
