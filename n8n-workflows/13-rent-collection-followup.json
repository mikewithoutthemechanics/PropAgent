          "from": {
            "email": "collections@agentloop.co.za",
            "name": "Agent Loop Collections"
          },
          "subject": "URGENT: Legal Escalation Required - Tenant 30+ Days Overdue",
          "content": [
            {
              "type": "text/plain",
              "value": "={{\n\n`LEGAL ESCALATION REQUIRED\n\n\n\nTenant: ${$json.first_name} ${$json.last_name}\n\nTenant ID: ${$json.id}\n\nDays Overdue: ${$json.days_overdue || $json.stage}\n\nAmount Owed: R${$json.amount_owed || $json.rent_amount}\n\nStage: ${$json.stage} days\n\n\n\nAI Recommendation: ${$json.escalation_recommended ? 'LEGAL ACTION' : 'CONTINUE COLLECTION'}\n\n\n\nAll collection attempts have been logged in Supabase.\n\nPlease initiate legal proceedings immediately.`\n\n}}"
            }
          ]
        }
      },
