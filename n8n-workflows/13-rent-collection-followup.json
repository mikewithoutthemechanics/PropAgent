            {
              "column": "tenant_id",
              "value": "={{ $json.id }}",
              "condition": "eq"
            },
            {
              "column": "stage",
              "value": "={{ $json.stage }}",
              "condition": "eq"
            }
          ]
        },
        "columns": {
