        400,
        450
      ]
    },
    {
      "parameters": {
        "operation": "select",
        "table": {
          "value": "tenants",
          "mode": "list"
        },
        "where": {
          "conditions": [
            {
              "column": "payment_status",
              "value": "overdue",
              "condition": "eq"
            },
            {
              "column": "days_overdue",
              "value": "30",
              "condition": "gte"
            }
          ]
        }
      },
      "name": "Query 30+ Days Overdue",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        400,
        600
      ]
    },
    {
      "parameters": {
        "jsCode": "// Merge all overdue tenant queries and tag with collection stage\nconst stage7 = $('Query 7 Days Overdue').all()[0]?.json?.data || [];\nconst stage14 = $('Query 14 Days Overdue').all()[0]?.json?.data || [];\nconst stage21 = $('Query 21 Days Overdue').all()[0]?.json?.data || [];\nconst stage30 = $('Query 30+ Days Overdue').all()[0]?.json?.data || [];\n\n// Tag tenants with stage and tone\nconst tagged7 = stage7.map(t => ({\n  ...t, \n  stage: 7, \n  tone: 'friendly',\n  tone_description: 'Friendly, helpful, assuming oversight'\n}));\n\nconst tagged14 = stage14.map(t => ({\n  ...t, \n  stage: 14, \n  tone: 'firm',\n  tone_description: 'Firm, professional, mentioning late fees'\n}));\n\nconst tagged21 = stage21.map(t => ({\n  ...t, \n  stage: 21, \n  tone: 'serious',\n  tone_description: 'Serious, consequences mentioned'\n}));\n\nconst tagged30 = stage30.map(t => ({\n  ...t, \n  stage: 30, \n  tone: 'final',\n  tone_description: 'Final notice, legal action imminent'\n}));\n\nconst allTenants = [...tagged7, ...tagged14, ...tagged21, ...tagged30];\n\nif (allTenants.length === 0) {\n  return [{ json: { message: 'No rent collection follow-ups needed today' } }];\n}\n\nreturn allTenants.map(t => ({ json: t }));"
      },
      "name": "Merge and Tag Stages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        650,
        400
      ]
    },
    {
      "parameters": {
        "batchSize": 5,
        "options": {}
      },
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        850,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "application/json",
        "body": {
          "model": "mixtral-8x7b-32768",
          "messages": [
            {
              "role": "system",
              "content": "You are a rent collection specialist for Agent Loop, a South African real estate platform. Generate escalating collection messages based on the stage of delinquency. Return ONLY valid JSON with no markdown formatting."
            },
            {
              "role": "user",
              "content": "={{\n\n`Generate a rent collection message:\n\n\n\nTenant: ${$json.first_name} ${$json.last_name}\n\nDays Overdue: ${$json.days_overdue || $json.stage}\n\nAmount Owed: R${$json.amount_owed || $json.rent_amount}\n\nPayment History: ${$json.payment_history || 'good'}\n\nPrevious Late Payments: ${$json.previous_late_count || 0}\n\nStage: ${$json.stage}\n\n\n\nMessage tone by stage:\n\n- 7 days: Friendly, helpful, assuming oversight\n\n- 14 days: Firm, professional, mentioning late fees\n\n- 21 days: Serious, consequences mentioned\n\n- 30 days: Final notice, legal action imminent\n\n\n\nTenant context: ${$json.known_circumstances || 'None known'}\n\n\n\nReturn JSON:\n\n{\n\n  \"message_sms\": \"under 160 chars\",\n\n  \"message_email_subject\": \"subject line\",\n\n  \"message_email_body\": \"full email text\",\n\n  \"message_whatsapp\": \"formatted for whatsapp\",\n\n  \"tone\": \"friendly|firm|serious|final\",\n\n  \"escalation_recommended\": true|false,\n\n  \"payment_plan_offered\": true|false\n\n}`\n\n}}"
            }
          ],
          "temperature": 0.7,
          "max_tokens": 500,
          "response_format": {
            "type": "json_object"
          }
        }
      },
      "name": "Groq AI Generate Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1050,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse Groq JSON response and merge with tenant data\nconst groqResponse = $json;\n\nlet aiResponse = {};\n\n\n\ntry {\n\n  // Handle both direct JSON and nested content\n\n  if (groqResponse.choices && groqResponse.choices[0]) {\n\n    const content = groqResponse.choices[0].message?.content;\n\n    aiResponse = typeof content === 'string' ? JSON.parse(content) : content;\n\n  } else {\n\n    aiResponse = groqResponse;\n\n  }\n\n} catch (error) {\n\n  // Fallback if JSON parsing fails\n\n  aiResponse = {\n\n    message_sms: 'Please contact us urgently regarding your outstanding rent.',\n\n    message_email_subject: 'Urgent: Rent Payment Required',\n\n    message_email_body: 'Please contact our office regarding your outstanding rent payment.',\n\n    message_whatsapp: 'Please contact us regarding your rent payment.',\n\n    tone: $('Split In Batches').item.json.tone,\n\n    escalation_recommended: $('Split In Batches').item.json.stage >= 30,\n\n    payment_plan_offered: false\n\n  };\n\n}\n\n\n\nconst tenant = $('Split In Batches').item.json;\n\n\n\nreturn {\n\n  json: {\n\n    ...tenant,\n\n    message_sms: aiResponse.message_sms?.substring(0, 160) || '',\n\n    message_email_subject: aiResponse.message_email_subject || '',\n\n    message_email_body: aiResponse.message_email_body || '',\n\n    message_whatsapp: aiResponse.message_whatsapp || '',\n\n    ai_tone: aiResponse.tone || tenant.tone,\n\n    escalation_recommended: aiResponse.escalation_recommended || tenant.stage >= 30,\n\n    payment_plan_offered: aiResponse.payment_plan_offered || false,\n\n    groq_request_id: groqResponse.id || null\n\n  }\n\n};"
      },
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1250,
        300
      ]
    },
