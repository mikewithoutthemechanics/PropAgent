    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.sendgrid.com/v3/mail/send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "application/json",
        "body": {
          "personalizations": [
            {
              "to": [{ "email": "legal@propagent.co.za" }]
            }
          ],
          "from": { "email": "collections@propagent.co.za", "name": "PropAgent Collections" },
          "subject": "URGENT: Legal Escalation Required - Tenant 30+ Days Overdue",
          "content": [
            {
              "type": "text/plain",
              "value": "={{
`LEGAL ESCALATION REQUIRED

Tenant: ${$json.first_name} ${$json.last_name}
Tenant ID: ${$json.id}
Days Overdue: ${$json.days_overdue || $json.stage}
Amount Owed: R${$json.amount_owed || $json.rent_amount}
Stage: ${$json.stage} days

AI Recommendation: ${$json.escalation_recommended ? 'LEGAL ACTION' : 'CONTINUE COLLECTION'}

All collection attempts have been logged in Supabase.
Please initiate legal proceedings immediately.`
}}"
            }
          ]
        }
      },
      "name": "Notify Legal Department",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [2050, 200]
    },
    {
      "parameters": {
        "operation": "update",
        "table": {
          "value": "rent_collection_log",
          "mode": "list"
        },
        "filter": {
