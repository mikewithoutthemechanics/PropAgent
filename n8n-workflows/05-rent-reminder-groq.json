    },
    "Query Due Today": {
      "main": [[{"node": "Merge Tenants", "type": "main", "index": 0}]]
    },
    "Query 3 Days Overdue": {
      "main": [[{"node": "Merge Tenants", "type": "main", "index": 0}]]
    },
    "Merge Tenants": {
      "main": [[{"node": "Batch Process", "type": "main", "index": 0}]]
    },
    "Batch Process": {
      "main": [[{"node": "Groq Generate Message", "type": "main", "index": 0}]]
    },
    "Groq Generate Message": {
      "main": [[{"node": "Extract Message", "type": "main", "index": 0}]]
    },
    "Extract Message": {
      "main": [[{"node": "Send SMS", "type": "main", "index": 0}]]
    },
    "Send SMS": {
      "main": [[{"node": "Log Reminder", "type": "main", "index": 0}]]
    }
  },
  "settings": {
