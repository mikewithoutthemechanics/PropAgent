{
  "name": "Rent Reminder Sequence",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "expression": "9"
            }
          ]
        }
      },
      "name": "Daily 9 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "operation": "select",
        "table": {
          "value": "tenants",
          "mode": "list"
        },
        "where": {
          "conditions": [
            {
              "column": "rent_due_date",
              "value": "={{ $now.plus({days: 3}).toFormat('yyyy-MM-dd') }}",
              "condition": "equal"
            },
            {
              "column": "status",
              "value": "active",
              "condition": "equal"
            }
          ]
        }
      },
      "name": "Get Tenants Due in 3 Days",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "operation": "select",
        "table": {
          "value": "payments",
          "mode": "list"
        },
        "where": {
          "conditions": [
            {
              "column": "tenant_id",
              "value": "={{ $json.id }}",
              "condition": "equal"
            },
            {
              "column": "period",
              "value": "={{ $now.toFormat('yyyy-MM') }}",
              "condition": "equal"
            }
          ]
        }
      },
      "name": "Check Payment Received",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-1",
              "leftValue": "={{ $json.length }}",
              "rightValue": "0",
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "name": "Payment Not Received?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "model": "gpt-3.5-turbo",
        "options": {
          "temperature": 0.7,
          "maxTokens": 250
        },
        "messages": {
          "message": [
            {
              "role": "system",
              "content": "You are a friendly property management assistant. Write a polite rent reminder email. Include: rent amount, due date, payment methods, and contact info for questions. Keep it friendly and professional."
            },
            {
              "role": "user",
              "content": "Tenant: {{ $json.first_name }} {{ $json.last_name }}\nProperty: {{ $json.property_address }}\nRent Amount: R{{ $json.rent_amount }}\nDue Date: {{ $json.rent_due_date }}\nDays Until Due: 3"
            }
          ]
        }
      },
      "name": "Generate Reminder Email",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        1050,
        200
      ]
    },
    {
      "parameters": {
        "sendOptions": {
          "sendEmail": [
            {
              "to": "={{ $json.email }}",
              "subject": "Friendly Reminder: Rent Due in 3 Days",
              "text": "={{ $('Generate Reminder Email').item.json.content }}"
            }
          ]
        }
      },
      "name": "Send Email Reminder",
      "type": "n8n-nodes-base.sendEmail",
      "typeVersion": 2,
      "position": [
        1250,
        200
      ]
    },
    {
      "parameters": {
        "to": "={{ $json.phone }}",
        "message": "Hi {{ $json.first_name }}, friendly reminder: Your rent of R{{ $json.rent_amount }} is due on {{ $json.rent_due_date }}. Pay online: [link] or contact us with questions."
      },
      "name": "Send SMS Reminder",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        1250,
        400
      ]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": {
          "value": "communications",
          "mode": "list"
        },
        "columns": {
          "mapping": [
            {
              "column": "contact_id",
              "value": "={{ $json.id }}"
            },
            {
              "column": "channel",
              "value": "email"
            },
            {
              "column": "type",
              "value": "rent_reminder"
            },
            {
              "column": "direction",
              "value": "outbound"
            }
          ]
        }
      },
      "name": "Log Reminder Sent",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        1450,
        300
      ]
    }
  ],
  "connections": {
    "Daily 9 AM": {
      "main": [
        [
          {
            "node": "Get Tenants Due in 3 Days",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Tenants Due in 3 Days": {
      "main": [
        [
          {
            "node": "Check Payment Received",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Payment Received": {
      "main": [
        [
          {
            "node": "Payment Not Received?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Payment Not Received?": {
      "main": [
        [
          {
            "node": "Generate Reminder Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Reminder Email": {
      "main": [
        [
          {
            "node": "Send Email Reminder",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send SMS Reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email Reminder": {
      "main": [
        [
          {
            "node": "Log Reminder Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send SMS Reminder": {
      "main": [
        [
          {
            "node": "Log Reminder Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["financial", "automation", "reminders"]
}
