{
  "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
  "name": "Tenant Inquiry Auto-Responder (Groq Free)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-inquiry",
        "responseMode": "responseNode"
      },
      "name": "WhatsApp Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "whatsapp-inquiry"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "application/json",
        "body": {
          "model": "llama-3.3-70b-versatile",
          "messages": [
            {
              "role": "system",
              "content": "You are a helpful real estate assistant for Agent Loop, a South African property agency. Classify the inquiry and respond appropriately.\n\nInquiry types:\n- VIEWING: Schedule property viewing\n- RENT: Rent payment, lease questions\n- MAINTENANCE: Repairs, issues with property\n- URGENT: Emergency (burst pipe, security issue)\n- GENERAL: Other questions\n\nRespond with JSON format:\n{\"type\": \"VIEWING|RENT|MAINTENANCE|URGENT|GENERAL\", \"response\": \"your response\", \"confidence\": 0.0-1.0}"
            },
            {
              "role": "user",
              "content": "={{ $json.body.message }}"
            }
          ],
          "temperature": 0.7,
          "max_tokens": 300
        },
        "options": {}
      },
      "name": "Groq AI Classify & Respond",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "// Parse Groq response\nconst groqResponse = $json;\nconst content = groqResponse.choices?.[0]?.message?.content || '{}';\n\n// Extract JSON from response\nlet parsed;\ntry {\n  // Try to find JSON in the response\n  const jsonMatch = content.match(/\\{[\\s\\S]*\\}/);\n  parsed = JSON.parse(jsonMatch ? jsonMatch[0] : content);\n} catch (e) {\n  parsed = {\n    type: 'GENERAL',\n    response: content.substring(0, 200),\n    confidence: 0.5\n  };\n}\n\nreturn {\n  json: {\n    inquiry_type: parsed.type || 'GENERAL',\n    ai_response: parsed.response || content.substring(0, 200),\n    confidence: parsed.confidence || 0.5,\n    original_message: $('WhatsApp Webhook').item.json.body?.message,\n    from_number: $('WhatsApp Webhook').item.json.body?.from\n  }\n};"
      },
      "name": "Parse Groq Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-1",
              "leftValue": "={{ $json.confidence }}",
              "rightValue": "0.7",
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Confidence Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.twilio.com/2010-04-01/Accounts/{{$credentials.twilioApi.accountSid}}/Messages.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "To",
              "value": "={{ $json.from_number }}"
            },
            {
              "name": "From",
              "value": "={{ $credentials.twilioApi.whatsappNumber }}"
            },
            {
              "name": "Body",
              "value": "={{ $json.ai_response }}"
            }
          ]
        }
      },
      "name": "Send WhatsApp Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": {
          "value": "whatsapp_conversations",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "phone": "={{ $json.from_number }}",
            "message": "={{ $json.original_message }}",
            "response": "={{ $json.ai_response }}",
            "inquiry_type": "={{ $json.inquiry_type }}",
            "confidence": "={{ $json.confidence }}",
            "created_at": "={{ $now }}"
          }
        }
      },
      "name": "Log to Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.twilio.com/2010-04-01/Accounts/{{$credentials.twilioApi.accountSid}}/Messages.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "To",
              "value": "={{ $credentials.twilioApi.agentNumber }}"
            },
            {
              "name": "From",
              "value": "={{ $credentials.twilioApi.whatsappNumber }}"
            },
            {
              "name": "Body",
              "value": "🔴 LOW CONFIDENCE INQUIRY\n\nFrom: {{ $json.from_number }}\nMessage: {{ $json.original_message }}\n\nPlease respond manually."
            }
          ]
        }
      },
      "name": "Escalate to Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 400]
    }
  ],
  "connections": {
    "WhatsApp Webhook": {
      "main": [[{"node": "Groq AI Classify & Respond", "type": "main", "index": 0}]]
    },
    "Groq AI Classify & Respond": {
      "main": [[{"node": "Parse Groq Response", "type": "main", "index": 0}]]
    },
    "Parse Groq Response": {
      "main": [[{"node": "Confidence Check", "type": "main", "index": 0}]]
    },
    "Confidence Check": {
      "main": [
        [{"node": "Send WhatsApp Reply", "type": "main", "index": 0}],
        [{"node": "Escalate to Agent", "type": "main", "index": 0}]
      ]
    },
    "Send WhatsApp Reply": {
      "main": [[{"node": "Log to Supabase", "type": "main", "index": 0}]]
    },
    "Escalate to Agent": {
      "main": [[{"node": "Log to Supabase", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": []
}
