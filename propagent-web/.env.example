# Copy to .env.local and fill in. NEVER commit .env.local.

# ---- Core app ----

# Keeps demo mode on (bypasses auth, seeds with mock data). Flip to "false"
# once real Supabase auth is wired and you want to require login.
NEXT_PUBLIC_DEMO_MODE=true

# ---- Supabase ----

NEXT_PUBLIC_SUPABASE_URL=https://sehweutpfftnrcbqshsn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Keep out of the browser. Used for admin operations and
# the lease-expiry cron.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Resend (email) ----

# https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified sender on a domain you own in Resend. For local dev
# you can use "agent-loop <onboarding@resend.dev>".
RESEND_FROM_EMAIL=agent-loop <onboarding@resend.dev>

# ---- Upstash Redis (rate limiting + cache) ----

# https://console.upstash.com -> your DB -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Groq Cloud (LLM) ----

# https://console.groq.com/keys
GROQ_API_KEY=
# Optional override. Defaults to llama-3.3-70b-versatile.
# GROQ_MODEL=llama-3.3-70b-versatile

# ---- Cron ----

# If set, /api/cron/* endpoints require Authorization: Bearer <value>
# (Vercel Cron sends this automatically).
CRON_SECRET=
