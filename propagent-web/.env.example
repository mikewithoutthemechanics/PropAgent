# Copy to .env.local and fill in. NEVER commit .env.local.

# ---- Core app ----

# Demo mode — bypasses auth and seeds mock data. Set to "false" for production.
NEXT_PUBLIC_DEMO_MODE=false

# Canonical site URL (used for PayFast callbacks, email links, OG meta).
# Set to your live domain in production.
NEXT_PUBLIC_SITE_URL=https://agentloop.co.za

# ---- Supabase ----

NEXT_PUBLIC_SUPABASE_URL=https://sehweutpfftnrcbqshsn.supabase.co

# Supabase anon (public) key — find in Supabase Dashboard → Settings → API → anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service_role key — find in Supabase Dashboard → Settings → API → service_role.
# Required for PayFast webhooks, cron jobs, and matching engine writes.
# Keep out of the browser. NEVER expose this in NEXT_PUBLIC_ vars.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Resend (email) ----

# https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified sender on a domain you own in Resend. For local dev
# you can use "Agent Loop <onboarding@resend.dev>".
RESEND_FROM_EMAIL=Agent Loop <onboarding@resend.dev>

# ---- Upstash Redis (rate limiting + cache) ----

# https://console.upstash.com -> your DB -> REST API
# Required for AI rate limiting and valuation caching.
# Without this, rate limiting is disabled and AI endpoints are unprotected.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Groq Cloud (LLM) ----

# https://console.groq.com/keys
GROQ_API_KEY=
# Optional override. Defaults to llama-3.3-70b-versatile.
# GROQ_MODEL=llama-3.3-70b-versatile

# ---- PayFast (payments) ----

# Set to "live" for production, "sandbox" for testing.
# Sandbox uses test credentials (merchant 10000100) automatically.
PAYFAST_MODE=sandbox

# Live credentials — find in PayFast Dashboard → Settings → Integration.
# Only needed when PAYFAST_MODE=live.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# ---- Cron ----

# Protects /api/cron/* endpoints. Vercel sends this automatically for scheduled crons.
# Generate a random string: openssl rand -hex 32
CRON_SECRET=
